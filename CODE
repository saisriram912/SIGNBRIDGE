<style>
body{font-family:Arial;margin:0;background:#f4f7fb;color:#172033}header{background:#172033;color:#fff;padding:18px 28px}
.modebar{max-width:1050px;margin:20px auto 0;padding:0 18px;display:flex;gap:10px}.mode{background:#dfe5ec;color:#172033}.mode.active{background:#172033;color:#fff}.learning{display:none}.learning-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.target{font-size:32px;font-weight:700;margin:12px 0}.feedback{padding:16px;border-radius:12px;background:#eef2f7;margin-top:14px;font-size:18px}.scorebar{height:12px;background:#dfe5ec;border-radius:8px;overflow:hidden;margin-top:10px}.scorefill{height:100%;width:0;background:#22a06b;transition:.3s}select{padding:10px;border-radius:8px;border:1px solid #ccd3dd;font-size:16px}.history{display:grid;gap:8px}.history div{padding:10px;background:#f4f6f8;border-radius:8px}main{max-width:1050px;margin:25px auto;padding:0 18px;display:grid;grid-template-columns:1.3fr .7fr;gap:20px}
.card{background:#fff;border-radius:16px;padding:18px;box-shadow:0 5px 20px #0001}
.wrap{position:relative}.wrap video{width:100%;border-radius:12px;display:block;transform:scaleX(-1)}
#canvas{position:absolute;inset:0;width:100%;height:100%;transform:scaleX(-1)}
.result{font-size:38px;font-weight:700;margin:15px 0}button{padding:12px 18px;border:0;border-radius:9px;background:#172033;color:#fff;font-size:16px}
.note{font-size:13px;color:#667085;line-height:1.5}.gesture-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:8px}.gesture-grid span{background:#f4f6f8;border-radius:8px;padding:8px;font-size:13px}.status{margin-top:12px;padding:10px;background:#eef2f7;border-radius:9px}.sign-card{display:flex;flex-direction:column;align-items:center;gap:5px;overflow:hidden}.sign-card img{width:100%;height:105px;object-fit:contain;border-radius:7px;background:#fff}
@media(max-width:800px){main{grid-template-columns:1fr}}
