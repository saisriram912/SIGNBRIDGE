document.getElementById('helloImg').src  = 'data:image/png;base64,------------------rWsAHREzkweiTw+cKiwNOFamgCr0tn7UQxPyPvE1a7PKokZ9nGNre36N+ylYhgcw6d2zwGk2DIDDYttWxIo8lKEOUVxS23PCEI51Ov12Pixjga5h4Mq0w4XY0x1LegX0oUE4uDprXesrLtivte4Xg17VLkasXYcnskGUQBNOrnQlzo3ftqm0Jj5Sf9zEHlPApapd------rWsAHREzkweiTw/90z/9b/7Nv8F/V2H0zG7vR5cPVflzlnHbX/f61/36//r1A2anQ8i9LEp2d+89i0YNOavELABTIKdI/QcX9AlYNCBtyqv/4A9fIdCevJJF4fvFGnagB/A+DWPFueoZ1jz0O2GO0tUQBNOrnQlzo3ftqm0Jj5Sf9zEHlPApapd---rWsAHREzkweiTw//7bgqmEAAAAGSURBVAMAw7FgrzWSa38AAAAASUVORK5CYII=';
</script>
<script>
const video=document.getElementById('video'),canvas=document.getElementById('canvas'),ctx=canvas.getContext('2d');
const word=document.getElementById('word'),conf=document.getElementById('conf'),status=document.getElementById('status');
let lastSpoken='', lastSpokenAt=0;
function d(a,b){return Math.hypot(a.x-b.x,a.y-b.y)}
function ext(l,t,p){return l[t].y<l[p].y}
function classify(l){
 let i=ext(l,8,6),m=ext(l,12,10),r=ext(l,16,14),p=ext(l,20,18);
 let c=[i,m,r,p].filter(Boolean).length;
 let th=d(l[4],l[17])>d(l[3],l[17])*1.15;
 // DOCTOR = pointing up (only index finger extended, thumb out)
 if(i&&!m&&!r&&!p&&th)return["DOCTOR",92];
 // HELLO  = open palm (all 4 fingers + thumb extended)
 if(c===4&&th)return["HELLO",91];
 if(c===0)return["STOP",90];
 if(i&&m&&!r&&!p)return["YES",84];
 if(i&&m&&r&&!p)return["WATER",80];
 if(!i&&m&&r&&p&&th)return["THANK YOU",88];
 if(i&&!m&&!r&&p&&th)return["FOOD",90];
 if(!i&&!m&&!r&&p)return["NO",78];
 if(i&&!m&&!r&&!p)return["HELP",82];
 if(i&&!m&&!r&&p)return["EMERGENCY",78];
 return["UNKNOWN",55];
}
const hands=new Hands({locateFile:f=>`https://cdn.jsdelivr.net/npm/@mediapipe/hands/${f}`});
hands.setOptions({maxNumHands:1,modelComplexity:1,minDetectionConfidence:.6,minTrackingConfidence:.6});
hands.onResults(res=>{
 canvas.width=video.videoWidth||640;canvas.height=video.videoHeight||480;ctx.clearRect(0,0,canvas.width,canvas.height);
 if(res.multiHandLandmarks?.length){let l=res.multiHandLandmarks[0];drawConnectors(ctx,l,HAND_CONNECTIONS,{lineWidth:3});drawLandmarks(ctx,l);
 let [w,c]=classify(l);word.textContent=w;conf.textContent=`Confidence: ${c}%`;status.textContent="Hand detected • Tracking active";
 if(w!=="UNKNOWN"&&c>75&&(w!==lastSpoken||Date.now()-lastSpokenAt>2200)){speechSynthesis.cancel();speechSynthesis.speak(new SpeechSynthesisUtterance(w));lastSpoken=w;lastSpokenAt=Date.now();}
 if(learningActive){lastDetectedEl.textContent=w;if(w!==lastEval){lastEval=w;attempts++;if(w===targetGesture.value){correct++;feedback.textContent='✅ Correct! Great job. Try again or change the target.';}else{feedback.textContent='🔄 Detected '+w+'. Keep practicing the target gesture.';}attemptsEl.textContent=attempts;correctEl.textContent=correct;let a=Math.round(correct/attempts*100);accuracyEl.textContent=a+'%';scoreFill.style.width=a+'%';}}
 }else status.textContent="Show one hand clearly to the camera.";
});
const camera=new Camera(video,{onFrame:async()=>await hands.send({image:video}),width:640,height:480});
document.getElementById('start').onclick=async()=>{try{await navigator.mediaDevices.getUserMedia({video:true});camera.start();status.textContent="Starting camera…"}catch(e){status.textContent="Allow camera permission and try again."}};
document.getElementById('speak').onclick=()=>{let t=word.textContent;if(t!=="—"){speechSynthesis.cancel();speechSynthesis.speak(new SpeechSynthesisUtterance(t))}};
const translationMode=document.getElementById('translationMode');
const learningMode=document.getElementById('learningMode');
const learningPanel=document.getElementById('learningPanel');
const targetGesture=document.getElementById('targetGesture');
const targetDisplay=document.getElementById('targetDisplay');
const practiceBtn=document.getElementById('practiceBtn');
const feedback=document.getElementById('feedback');
const scoreFill=document.getElementById('scoreFill');
const attemptsEl=document.getElementById('attempts');
const correctEl=document.getElementById('correct');
const accuracyEl=document.getElementById('accuracy');
const lastDetectedEl=document.getElementById('lastDetected');
const emoji={HELLO:'🖐️',HELP:'🙋',WATER:'🤲',EMERGENCY:'🙌',FOOD:'🤟',DOCTOR:'☝️','THANK YOU':'🤙',STOP:'✋',YES:'👍',NO:'👎'};
let learningActive=false,attempts=0,correct=0,lastEval='';
function updateTarget(){const t=targetGesture.value;targetDisplay.textContent=(emoji[t]||'✋')+' '+t;}
targetGesture.onchange=updateTarget;updateTarget();
translationMode.onclick=()=>{translationMode.classList.add('active');learningMode.classList.remove('active');learningPanel.style.display='none';learningActive=false;};
learningMode.onclick=()=>{learningMode.classList.add('active');translationMode.classList.remove('active');learningPanel.style.display='block';};
practiceBtn.onclick=()=>{learningActive=true;attempts=0;correct=0;lastEval='';attemptsEl.textContent='0';correctEl.textContent='0';accuracyEl.textContent='0%';scoreFill.style.width='0%';feedback.textContent='Show the target gesture to the camera.';};
</script></body></html>
